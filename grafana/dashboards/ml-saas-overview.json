{
  "dashboard": {
    "title": "ML SaaS - Multi-Tenant Overview",
    "tags": ["ml-saas", "multi-tenant"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Active Tenants",
        "type": "stat",
        "targets": [
          {
            "expr": "ml_active_tenants"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Total Models Deployed",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(ml_models_deployed_total)"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Drift Alerts (Last 24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(ml_drift_alerts_total[24h]))"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Auto-Retraining Events (Last 24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(ml_retraining_triggered_total[24h]))"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Training Runs by Tenant",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ml_training_runs_total[5m])",
            "legendFormat": "{{ tenant_id }}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 6,
        "title": "Drift Score by Model",
        "type": "graph",
        "targets": [
          {
            "expr": "ml_drift_score",
            "legendFormat": "{{ tenant_id }} - {{ model_id }}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        }
      },
      {
        "id": 7,
        "title": "Prediction Latency (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ml_prediction_latency_seconds_bucket[5m]))",
            "legendFormat": "{{ tenant_id }} - {{ model_id }}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 8,
        "title": "Model F1 Score by Tenant",
        "type": "graph",
        "targets": [
          {
            "expr": "ml_model_f1_score",
            "legendFormat": "{{ tenant_id }} - {{ model_name }}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
